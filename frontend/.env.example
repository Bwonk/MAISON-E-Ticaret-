# ═══════════════════════════════════════════════════
# ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Vite exposes only VITE_* prefixed variables.
# ═══════════════════════════════════════════════════

# ─── API ──────────────────────────────────────────
# Base URL for product data + checkout endpoints.
# Points to the Express server on EC2.
# No trailing slash.
VITE_API_BASE_URL=https://api.yigitlabs.com

# ─── DATA SOURCE ─────────────────────────────────
# Which product data source to use.
# Options: "json" | "strapi" | "rest"
#   json   → reads from src/data/products.json (offline/dev)
#   strapi → fetches from Strapi v4 API (populate=*)
#   rest   → fetches from custom REST endpoint
VITE_DATA_SOURCE=strapi

# ─── STRAPI ──────────────────────────────────────
# Strapi API token (required only when DATA_SOURCE=strapi).
# Generate from: dash.yigitlabs.com → Settings → API Tokens
VITE_STRAPI_TOKEN=cfc6958a7197208dea4877d94c494a6cbd83d9a6082fe0e7a3d13ee9ac6d816bfd3194962f429d84ab172d43d7639c8dd236ecf9f664107cb50f7ccdecd15ef6522d714a16f070ea9a816b4f5891b4acada69e4d1eaf282c5932300109a8dd4c5d2144ea5d8228f4765e3cef63f7a330a94d01e5320162fca26197e3879980f8

# ─── AUTH ─────────────────────────────────────────
# Base URL for authentication endpoints.
# Same EC2 instance as API, separate route namespace.
VITE_AUTH_BASE_URL=https://api.yigitlabs.com

# ─── STRIPE ──────────────────────────────────────
# Stripe publishable key (never the secret key).
# Sandbox: pk_test_...  |  Live: pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
